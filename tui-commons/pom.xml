<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

	<parent>
		<groupId>org.tauasa</groupId>
		<artifactId>tui-java</artifactId>
		<version>1.0.2-SNAPSHOT</version>
	</parent>

	<modelVersion>4.0.0</modelVersion>

	<artifactId>tui-commons</artifactId>
	<packaging>jar</packaging>
	<name>Tui Commons</name>
	<description>A generic plumbing library: basic I/O, XML/XPath, JDBC, GIS, string manipulation, bit twiddling, metrics, etc</description>

	<dependencies>

		<!-- Optional: only StringDistanceUtils needs it. It brings log4j 1.2.17,
		     so an app that uses StringDistanceUtils adds it itself. -->
		<dependency>
			<groupId>com.wcohen</groupId>
			<artifactId>com.wcohen.secondstring</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- Optional: only SpringApplicationContext needs it, and an app that
		     uses it already has Spring. -->
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-context</artifactId>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.jdbi</groupId>
			<artifactId>jdbi</artifactId>
		</dependency>

		<dependency>
			<groupId>com.google.code.gson</groupId>
			<artifactId>gson</artifactId>
		</dependency>

		<dependency>
			<groupId>commons-codec</groupId>
			<artifactId>commons-codec</artifactId>
		</dependency>

		<dependency>
			<groupId>joda-time</groupId>
			<artifactId>joda-time</artifactId>
		</dependency>

	</dependencies>


</project>
